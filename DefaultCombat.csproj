<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RootNamespace>DefaultCombat</RootNamespace>
    <AssemblyName>DefaultCombat</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup>
    <BuddyCronRefsProps>$([MSBuild]::GetPathOfFileAbove('BuddyCronRefs.props', '$(MSBuildThisFileDirectory)'))</BuddyCronRefsProps>
  </PropertyGroup>

  <Import Project="$(BuddyCronRefsProps)" Condition="'$(BuddyCronRefsProps)' != ''" />

  <!-- Standalone checkouts do not contain the repository-wide props file. Use the same
       compile-only package so CI type-checks against the host API without private binaries. -->
  <ItemGroup Condition="'$(BuddyCronRefsProps)' == ''">
    <PackageReference Include="BuddyCron.ReferenceAssemblies"
                      Version="1.0.*"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
